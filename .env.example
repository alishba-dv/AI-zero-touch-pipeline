# Jira Configuration
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# Project Settings
PROJECT_KEY=SCRUM

# Build Tool: maven | gradle | npm | pytest | make
BUILD_TOOL=maven

# Maven module path (relative to project root, or '.' for root)
BUILD_MODULE=.

# Source directories (relative to project root)
SRC_DIR=src/main/java
TEST_DIR=src/test/java

# Base package for generated Java code (e.g. com.example.app)
BASE_PACKAGE=com.example.app

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# GitHub
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_USERNAME=your-github-username
GITHUB_REPO=AI-zero-touch-pipeline
